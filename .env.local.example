# Database
DATABASE_URL=postgresql://user:password@db:5432/finance

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-32-plus-char-random-string
NEXTAUTH_URL=http://localhost:3000

# Auth credentials (single-user app)
AUTH_USERNAME=mqualls
# Generate the hash: node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
# Then base64-encode it (Docker Compose mangles the raw $2b$12$... hash — see CLAUDE.md):
#   node -e "console.log(Buffer.from(process.argv[1]).toString('base64'))" '<hash from above>'
AUTH_PASSWORD_HASH_B64=change-me-see-comment-above

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Postgres container
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=finance

# Plaid
PLAID_CLIENT_ID=change-me
PLAID_SECRET=change-me
PLAID_ENV=sandbox

# Random 32-byte key, base64-encoded, used to encrypt PlaidItem.accessToken at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-random-bytes-base64
